# Copy to .env for local development. See SPEC.md §15.
DATABASE_URL=postgresql+psycopg://tmk:tmk@localhost:5432/tmk
SECRET_KEY=change-me
BASE_URL=http://localhost:8000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GRADING_EFFORT=low
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=tmk-recommender
POSTMARK_SERVER_TOKEN=
# Without a Postmark token, send through SMTP, e.g. a Gmail account with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=
GRADE_LIMIT_PER_WEEK=100
FULLTEXT_MAX_TOKENS=12000
LLM_MONTHLY_CAP_USD=30
PERTINENCE_GATE=0.30
EMAIL_MIN_WEIGHTED=3.2
ACTIVE_WINDOW_DAYS=90
PROFILE_COEF_TOPICS=1.0
PROFILE_COEF_SEEDS=1.0
PROFILE_COEF_LIKED=0.5
PROFILE_COEF_NOT_FOR_ME=0.3
PERTINENCE_THRESHOLDS=[0.50, 0.58, 0.65, 0.72]
